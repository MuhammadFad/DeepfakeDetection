# Virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Environment variables
.env
.env.local

# Generated outputs — regenerated by python main.py
output/

# Training/validation images — re-populate with: python download_data.py --count 50
# .gitkeep files preserve the directory structure; actual images are excluded
images/train/real/*
!images/train/real/.gitkeep
images/train/fake/*
!images/train/fake/.gitkeep
images/val/real/*
!images/val/real/.gitkeep
images/val/fake/*
!images/val/fake/.gitkeep

# Flat layout not used — ignore the directories entirely
images/real/
images/fake/

# IDE
.vscode/
.idea/
*.suo
*.sw?

# OS
.DS_Store
Thumbs.db
desktop.ini
